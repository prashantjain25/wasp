def _model_sublist(p, name):
    """Build model sublist options for a provider. Returns (ids, labels)."""
    if p.is_running():
        ids = p.live_models()
        cur_model = load_state().get("model", "")
    else:
        mlist = provider_cfg(name).get("models", [])
        ids = [m["id"] for m in mlist]
        cur_model = ""
    name_map = {}
    for m in provider_cfg(name).get("models", []):
        name_map[m["id"]] = m.get("name", m["id"])
    # Only show configured models, in config order
    mopts = []
    ids_filtered = []
    for m in provider_cfg(name).get("models", []):
        mid = m["id"]
        if mid in ids:
            ids_filtered.append(mid)
            label = name_map.get(mid, mid)
            if p.is_running() and mid == cur_model: label += " [running]"
            mopts.append(label)
    return ids_filtered, mopts
    return ids, mopts

def cmd_start(providers: Dict[str, ProviderAdapter]) -> str:
    """Two-level picker: backend -> model."""
    names = list(providers.keys())
    opts = [f"  {n} [{'RUNNING' if providers[n].is_running() else 'STOPPED'}]" for n in names]
    opts.append("Cancel")
    idx = pick(opts, "Select backend")
    if idx < 0 or idx >= len(names): return ""
    name = names[idx]
    p = providers[name]
    ids, mopts = _model_sublist(p, name)
    mopts = ["Start all " + name + " models"] + mopts
    mopts.append("Cancel")
    midx = pick(mopts, "Select model for " + name)
    if midx < 0 or midx >= len(mopts) - 1: return ""
    if midx == 0:
        if not p.is_running():
            print(p.start())
            if not p.is_running():
                return f"  Failed to start {name}"
        save_state(backend=name)
        return "  Switched: " + name
    mid = ids[midx - 1]
    if not p.is_running():
        print(p.start())
        if not p.is_running():
            return f"  Failed to start {name}"
    save_state(backend=name, model=mid)
    return "  Switched: " + name + ":" + mopts[midx]

def cmd_stop(providers: Dict[str, ProviderAdapter]) -> str:
    """Two-level picker: backend -> stop all or pick model."""
    names = list(providers.keys())
    opts = [f"  {n} [{'RUNNING' if providers[n].is_running() else 'STOPPED'}]" for n in names]
    opts.append("Cancel")
    idx = pick(opts, "Select backend to stop")
    if idx < 0 or idx >= len(names): return ""
    name = names[idx]
    p = providers[name]
    if not p.is_running(): return f"  {name} not running"
    # Show models with "Stop all" first, then individual models
    ids = p.live_models()
    cur_model = load_state().get("model", "")
    mopts = ["Stop all " + name + " models"]
    for m in provider_cfg(name).get("models", []):
        mid = m["id"]
        if mid in ids:
            label = m.get("name", mid)
            if mid == cur_model: label += " [running]"
            mopts.append(label)
    mopts.append("Cancel")
    midx = pick(mopts, "Stop " + name)
    if midx < 0 or midx >= len(mopts) - 1: return ""
    return p.stop()


def cmd_search(q: str, mcp: Optional[dict]) -> str:
    if not q: return "  Usage: /search <query>"
    if not mcp: return "  No MCP search tool."
    print("  Searching...", end="", flush=True)
