def run_agent_chat(messages: list, model_id: str = "", internet_on: bool = False) -> str:
    """Run agentic chat using smolagents CodeAgent."""
    from smolagents import CodeAgent, OpenAIModel
    tools = build_agent_tools(internet_on)
    model = OpenAIModel(model_id=model_id or "qwen2.5:1.5b", api_base="http://localhost:11434/v1")
    agent = CodeAgent(tools=tools, model=model, max_steps=10, verbosity=0)
    last = messages[-1]["content"] if messages else ""
    log("AGENT START", last[:80])
    result = agent.run(last)
    log("AGENT DONE", str(result)[:80])
    return str(result)

def run_agent(task: str, internet_on: bool) -> str:
    """Legacy: one-shot agent call."""
    messages = [{"role": "user", "content": task}]
    return run_agent_chat(messages, internet_on=internet_on)

