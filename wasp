def _build_whitelist() -> set:
    """Build flat whitelist set from config."""
    cfg = load_config().get("agent", {}).get("bash_whitelist", {})
    return {cmd for group in cfg.values() for cmd in group}

def _blocked_patterns(cmd: str) -> bool:
    """Check for dangerous command patterns."""
    dangerous = ["rm -rf /", "rm -rf /*", "dd if=", "> /dev/sd", "mkfs.", ":(){ :|& };:"]
    return any(p in cmd for p in dangerous)

def build_agent_tools(internet_on: bool = False) -> list:
    """Build tool list for smolagents CodeAgent."""
    from smolagents import tool
    tools = [tool(_bash_tool), tool(_write_tool), tool(_read_tool), tool(_edit_tool)]
    if internet_on:
        tools += [tool(_web_search_tool), tool(_web_read_tool)]
    return tools

