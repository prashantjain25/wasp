def worker_agent_panel() -> str:
    """Show agent configuration dashboard."""
    log("WORKER agent")
    cfg = load_config().get("agent", {}).get("bash_whitelist", {})
    s = load_state()
    ag = s.get("agentic", False)
    intr = s.get("internet", False)
    while True:
        opts = [
            "  Agentic mode: " + ("ON" if ag else "OFF"),
            "  Internet tools: " + ("ON" if intr else "OFF"),
            "  Show allowed commands",
            "  Return"
        ]
        idx = pick(opts, "Agent")
        if idx < 0 or idx == 3: return ""
        if idx == 0:
            ag = not ag
            save_state(agentic=ag)
        elif idx == 1:
            intr = not intr
            save_state(internet=intr)
        elif idx == 2:
            total = sum(len(v) for v in cfg.values())
            print("  Commands whitelist (" + str(total) + " total):")
            for group, cmds in cfg.items():
                print("    " + group + ": " + ", ".join(sorted(cmds)))
            print("  Edit: ~/.llm_config.json agent.bash_whitelist")
        input("  Press Enter to continue...")

