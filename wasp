# Logger (simple file-based)
# ═══════════════════════════════════════════════

def log(msg: str, data: str = "") -> None:
    if not LOG_ENABLED: return
    ts = datetime.datetime.now().strftime("%H:%M:%S.%f")[:12]
    with open(LOG_FILE, "a") as f:
        f.write(f"[{ts}] {msg}")
        if data: f.write(f" {data[:200]}")
        f.write("\n")

