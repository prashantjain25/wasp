class LlmCli:
    """
    Facade: single entry point that wires everything together.
    Parses args, initializes providers + MCP, runs the REPL.
    """

    def __init__(self) -> None:
        self.mcp_clients: Optional[dict] = None
        self.providers: Dict[str, ProviderAdapter] = {}
        self.messages: List[dict] = []

    # ── Bootstrap ──────────────────────────────────────────────────────────

    def run(self, argv: List[str]) -> None:
        log("START", f"args={argv[1:]}")

        parser = ArgumentParser(description="wasp - Facade > Adapter > Proxy")
        parser.add_argument("prompt", nargs="*")
        parser.add_argument("-m", "--model")
        parser.add_argument("-l", "--list", action="store_true")
        parser.add_argument("-b", "--backend")
        args = parser.parse_args(argv[1:])

        # Build adapters
        self.providers = all_adapters()
        if not self.providers:
            print("  No providers configured.", file=sys.stderr); sys.exit(1)

        # --backend flag
        if args.backend:
            if args.backend not in self.providers:
                print(f"  Unknown: {args.backend}", file=sys.stderr); sys.exit(1)
            save_state(backend=args.backend)

        # --list
        if args.list:
            for n, p in self.providers.items():
                print(f"  {n}: {', '.join(p.configured_model_names())}")
            sys.exit(0)

        # Pipe mode
        if not sys.stdin.isatty() and not args.prompt:
            backend = active_adapter()
            model_ids = backend.live_models() if backend else []
            model = args.model or (model_ids[0] if model_ids else None)
            backend.chat([{"role": "user", "content": sys.stdin.read()}], model or "")
            sys.exit(0)

        # Init MCP
        self.mcp_clients, _ = init_mcp()

        try:
            self._repl(args)
        finally:
            close_mcp(self.mcp_clients)
            log("STOP")

    # ── REPL ────────────────────────────────────────────────────────────────

    def _repl(self, args) -> None:
        self.messages = [{"role": "system", "content": "You are a helpful assistant."}]

        # Direct prompt → respond, then enter REPL for follow-ups
        if args.prompt:
            text = " ".join(args.prompt)
            if text.startswith("/search"):
                print(cmd_search(text[7:], self.mcp_clients))
                return
            self._chat_and_continue(text, args.model)
            self._repl_loop("... ", args.model)
            return

        # Empty REPL
        self._repl_loop(">>> ", args.model)

    def _repl_loop(self, prompt: str, model: str = "") -> None:
        """Shared REPL dispatch loop."""
        while True:
            line = self._read(prompt)
            if line is None: return
            if line in ("/exit","/quit"): return
            if line == "/new": self.messages = []; print("  Reset."); return
            if line == "/help": print(HELP); continue
            if self._dispatch(line): continue
            self._chat_and_continue(line, model)

    # ── Helpers ─────────────────────────────────────────────────────────────

    def _read(self, prompt: str) -> Optional[str]:
        try:
            line = input(prompt).strip()
            return line if line else None
        except (EOFError, KeyboardInterrupt):
            print(); return None

    def _dispatch(self, line: str) -> bool:
        """Try to dispatch as a command. Returns True if handled."""
        if line.startswith("/search"):
            print(cmd_search(line[7:], self.mcp_clients))
            return True
        if line in COMMANDS:
            print(COMMANDS[line](self.providers))
            return True
        if line.startswith("/"):
            print(f"  Unknown: {line}")
            return True
        return False

    def _chat_and_continue(self, text: str, model: str = "") -> None:
        self.messages.append({"role": "user", "content": text})
        s = load_state()
        if s.get("agentic", False):
            result = run_agent_chat(self.messages, model, s.get("internet", False))
            print("\n  " + result)
            self.messages.append({"role": "assistant", "content": result})
            return
        adapter = active_adapter()
        if not adapter:
            print("  No backend.", file=sys.stderr); return
        resp = adapter.chat(self.messages, model)
        # Save assistant response if we got one back
        if resp:
            self.messages.append({"role": "assistant", "content": resp})


# ═══════════════════════════════════════════════
# Entry
# ═══════════════════════════════════════════════

def main() -> None:
    LlmCli().run(sys.argv)

if __name__ == "__main__":
    main()
