# MCP Client (JSON-RPC over stdio)
# ═══════════════════════════════════════════════

class McpClient:
    def __init__(self, cfg: dict) -> None:
        self.cfg, self.proc, self.rid = cfg, None, 0
        self.pending: Dict[int, list] = {}

    def start(self) -> None:
        cmd = [self.cfg["command"]] + self.cfg.get("args", [])
        env = os.environ.copy(); env.update(self.cfg.get("env", {}))
        self.proc = subprocess.Popen(cmd, stdin=subprocess.PIPE, stdout=subprocess.PIPE,
                                      stderr=subprocess.PIPE, env=env, text=True)
        threading.Thread(target=self._reader, daemon=True).start()

    def _reader(self) -> None:
        while self.proc and self.proc.stdout:
            line = self.proc.stdout.readline()
            if not line: break
            try:
                m = json.loads(line.strip())
                rid = m.get("id")
                if rid and rid in self.pending:
                    self.pending[rid].append(m)
            except: pass

    def _send(self, method: str, params: dict = None) -> int:
        self.rid += 1
        req = {"jsonrpc": "2.0", "id": self.rid, "method": method, "params": params or {}}
        self.pending[self.rid] = []
        if self.proc and self.proc.stdin:
            self.proc.stdin.write(json.dumps(req) + "\n")
            self.proc.stdin.flush()
        return self.rid

    def _wait(self, rid: int, timeout: int = 60) -> dict:
        deadline = time.time() + timeout
        while time.time() < deadline:
            if rid in self.pending and self.pending[rid]:
                for r in reversed(self.pending[rid]):
                    if "result" in r or "error" in r:
                        self.pending.pop(rid, None); return r
            time.sleep(0.05)
        self.pending.pop(rid, None)
        return {"error": {"message": "timeout"}}

    def initialize(self) -> None:
        self.start(); time.sleep(0.5)
        rid = self._send("initialize", {"protocolVersion": "2024-11-05", "capabilities": {},
                                        "clientInfo": {"name":"wasp","version":"1.0"}})
        self._wait(rid, 15)
        self._send("notifications/initialized")

    def list_tools(self) -> list:
        r = self._wait(self._send("tools/list"), 15)
        return r.get("result", {}).get("tools", []) if "result" in r else []

    def call_tool(self, name: str, args: dict) -> list:
        r = self._wait(self._send("tools/call", {"name": name, "arguments": args}), MCP_TOOL_TIMEOUT)
        if "result" in r: return r["result"].get("content", [])
        return [{"type": "text", "text": f"Error: {r.get('error',{}).get('message','?')}"}]

    def close(self) -> None:
        if not self.proc: return
        try:
            self._send("shutdown"); self.proc.terminate(); self.proc.wait(3)
        except: self.proc.kill()


def init_mcp() -> Tuple[Optional[dict], List[str]]:
    try:
        with open(MCP_CONFIG) as f: servers = json.load(f).get("mcpServers", {})
    except: return None, []
    clients, all_names = {}, []
    for name, cfg in servers.items():
        if cfg.get("type") != "stdio": continue
        try:
            c = McpClient(cfg); c.initialize()
            tools = c.list_tools()
            clients[name] = {"client": c, "tools": tools}
            names = [t["name"] for t in tools]
            all_names.extend(names)
            print(f"  MCP [{name}]: {len(tools)} tools")
        except Exception as e: log(f"MCP {name}", str(e))
    return (clients if clients else None), all_names

def close_mcp(clients: Optional[dict]) -> None:
    if not clients: return
    for _, d in clients.items():
        c = d.get("client")
        if c:
            try: c.close()
            except: pass

def web_search(query: str, clients: Optional[dict]) -> Optional[str]:
    if not clients: return None
    for _, d in clients.items():
        c = d.get("client")
        if not c: continue
        try:
            r = c.call_tool("jina_search", {"query": query})
            txt = "\n".join(x.get("text","") for x in r if x.get("type")=="text")[:3000]
            if txt.strip(): return txt
        except Exception as e: log("SEARCH", str(e))
    return None

