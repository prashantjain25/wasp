def _stream_response(resp, adapter):
    """Parse streaming response lines into text."""
    content = ""
    for raw in resp:
        line = raw.decode().strip() if isinstance(raw, bytes) else raw.strip()
        if not line: continue
        if adapter.is_stream_sse():
            if line.startswith("data: "): line = line[6:]
            if line == "[DONE]": break
        try:
            token = adapter.parse_chunk(json.loads(line))
            if token:
                content += token
                print(token, end="", flush=True)
        except json.JSONDecodeError:
            log("PARSE", line[:100])
    return content

class ProviderAdapter(ABC):
    """Strategy interface: every backend must implement these."""

    def __init__(self, name: str, cfg: dict) -> None:
        self.name = name
        self.cfg = cfg
        self.base = cfg.get("base_url", "").rstrip("/")

    @abstractmethod
    def models_path(self) -> str: ...
    @abstractmethod
    def chat_path(self) -> str: ...
    @abstractmethod
    def parse_model_list(self, raw: dict) -> List[str]: ...
    @abstractmethod
    def parse_chunk(self, chunk: dict) -> str: ...
    def is_stream_sse(self) -> bool: return False
    def default_model(self) -> str: return self.cfg.get("default_model", "default")

    # ── Shared ─────────────────────────────────────────────────────────────

    def url(self, path: str) -> str:
        return self.base + "/" + path.lstrip("/")

    def is_running(self) -> bool:
        try:
            urllib.request.urlopen(urllib.request.Request(self.url(self.models_path())), timeout=2)
            return True
        except: return False

    def live_models(self) -> List[str]:
        try:
            req = urllib.request.Request(self.url(self.models_path()),
                                         headers={"Content-Type": "application/json"})
            data = json.loads(urllib.request.urlopen(req, timeout=5).read())
            return self.parse_model_list(data)
        except:
            return [m["id"] for m in self.cfg.get("models", [])]

    def configured_model_names(self) -> List[str]:
        return [m.get("name", m["id"]) for m in self.cfg.get("models", [])]

    def chat(self, messages: List[dict], model: str = "") -> str:
        """Stream a chat response. Returns the full response text."""
        if not model:
            models = self.live_models()
            model = models[0] if models else self.default_model()

        payload = {"model": model, "messages": messages, "stream": True}
        # Only Ollama backend uses options; OpenAI-compatible ignores them
        opts = self.cfg.get("options", {})
        if opts and not self.is_stream_sse():
            payload["options"] = opts

        log(f"CHAT {self.name}@{model}",
            json.dumps([{"role": m["role"], "content": (m.get("content","") or "")[:60]}
                       for m in messages]))

        body = json.dumps(payload).encode()
        req = urllib.request.Request(
            self.url(self.chat_path()), data=body,
            headers={"Content-Type": "application/json"})
        resp = urllib.request.urlopen(req, timeout=120)

        content = _stream_response(resp, self)

        print()
        log(f"RESP ({len(content)}c)", content[:100])
        return content

    def start(self) -> str:
        if self.is_running(): return f"  {self.name} already running"
        cmd = self.cfg.get("start_cmd", "")
        if not cmd: return f"  No start_cmd for {self.name}"
        log(f"START {self.name}")
        os.system(cmd + " 2>/dev/null")
        for _ in range(BACKEND_POLLS):
            time.sleep(0.5)
            if self.is_running():
                log(f"START {self.name} OK")
                return f"  {self.name} started"
        return f"  {self.name} start timed out"

    def stop(self) -> str:
        if not self.is_running(): return f"  {self.name} not running"
        cmd = self.cfg.get("stop_cmd", "")
        if not cmd: return f"  No stop_cmd for {self.name}"
        log(f"STOP {self.name}")
        os.system(cmd + " 2>/dev/null")
        time.sleep(1)
        return f"  {self.name} stopped" if not self.is_running() else f"  Failed to stop {self.name}"


class OllamaAdapter(ProviderAdapter):
    """Native Ollama HTTP API."""

    def models_path(self) -> str: return "/api/tags"
    def chat_path(self) -> str: return "/api/chat"
    def is_stream_sse(self) -> bool: return False

    def parse_model_list(self, raw: dict) -> List[str]:
        return [m["name"] for m in raw.get("models", [])]

    def parse_chunk(self, chunk: dict) -> str:
        return chunk.get("message", {}).get("content", "")


class OpenAiAdapter(ProviderAdapter):
    """OpenAI-compatible API (used by LlamaFile, Crush providers, etc.)."""

    def models_path(self) -> str: return "/v1/models"
    def chat_path(self) -> str: return "/v1/chat/completions"
    def is_stream_sse(self) -> bool: return True

    def parse_model_list(self, raw: dict) -> List[str]:
        ids = [m["id"] for m in raw.get("data", [])]
        return [i.split("/")[-1].replace(".gguf", "") for i in ids]

    def parse_chunk(self, chunk: dict) -> str:
        return chunk.get("choices", [{}])[0].get("delta", {}).get("content", "")


# ═══════════════════════════════════════════════
# Proxy — LoggingProxy wraps any adapter
# ═══════════════════════════════════════════════

class LoggingProxy(ProviderAdapter):
    """Wraps a ProviderAdapter, logging all calls via the outer log() function."""

    def __init__(self, inner: ProviderAdapter) -> None:
        self._inner = inner
        super().__init__(inner.name, inner.cfg)

    def __getattr__(self, name: str):
        return getattr(self._inner, name)

    def models_path(self) -> str: return self._inner.models_path()
    def chat_path(self) -> str: return self._inner.chat_path()
    def is_stream_sse(self) -> bool: return self._inner.is_stream_sse()
    def parse_model_list(self, raw: dict) -> List[str]: return self._inner.parse_model_list(raw)
    def parse_chunk(self, chunk: dict) -> str: return self._inner.parse_chunk(chunk)
    def default_model(self) -> str: return self._inner.default_model()


