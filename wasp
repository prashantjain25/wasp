# Factory — creates the right adapter per provider
# ═══════════════════════════════════════════════

# Future cloud/internet LLM providers register here:
#   "openai-api": OpenAiCloudAdapter,   # OpenAI API (requires API key)
#   "anthropic": AnthropicAdapter,      # Anthropic/Claude API
# Each adapter extends ProviderAdapter with cloud-specific auth/retry.
ADAPTER_TYPES = {
    "ollama": OllamaAdapter,
    "openai": OpenAiAdapter,
}

def create_provider(name: str) -> Optional[ProviderAdapter]:
    """Factory: build an adapter for the named provider, wrapped in LoggingProxy."""
    cfg = provider_cfg(name)
    if not cfg:
        return None
    ptype = cfg.get("type", "ollama")
    cls = ADAPTER_TYPES.get(ptype)
    if not cls:
        log(f"UNKNOWN TYPE {ptype}", name)
        return None
    raw = cls(name, cfg)
    return LoggingProxy(raw)

def all_adapters() -> Dict[str, ProviderAdapter]:
    return {n: create_provider(n) for n in provider_names() if create_provider(n)}

def active_adapter() -> Optional[ProviderAdapter]:
    s = load_state()
    bk = s.get("backend", "")
    if bk not in provider_names():
        bk = provider_names()[0] if provider_names() else ""
    return create_provider(bk)

